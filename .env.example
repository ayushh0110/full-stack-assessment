# Copy to .env in the repository root. Everything is optional for local development.

# TomTom truck routing. Without a key the app falls back to OSRM car routing (development only).
TOMTOM_API_KEY=

DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared cache (route sets, place searches, quota counters). In-memory cache when empty.
REDIS_URL=

# Set to 1 behind one proxy hop (Cloud Run, Render) so rate limits use the real client IP.
NUM_PROXIES=0

# Daily budgets per provider (see backend/config/settings.py for all settings).
QUOTA_TOMTOM_ROUTING_DAILY=600
QUOTA_PHOTON_DAILY=5000
